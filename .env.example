# data_platform Phase-0 — copy to backend/.env and/or frontend/.env.local
# Production deploy checklist (Korean): see project store docs/clerk-deploy-setup.md
# Repo auth notes: docs/auth-clerk.md

# --- Database (optional; default SQLite under ./data when unset) ---
# Match docker-compose.yml credentials (user/pass/db = dataplat / dataplat / data_platform):
# DATABASE_URL=postgresql+psycopg://dataplat:dataplat@127.0.0.1:5432/data_platform
# Inside Compose the API service already sets DATABASE_URL to host `db`.

# --- Verification queue (optional Redis worker) ---
# sync: always run run_automated_stages on the request thread (good for local smoke)
# async: enqueue to Redis; requires worker (`python -m app.worker`)
# auto (default): async when REDIS_URL is reachable, else sync; Redis-down → sync fallback
# VERIFY_MODE=sync
# REDIS_URL=redis://127.0.0.1:6379/0
# VERIFY_QUEUE_KEY=verify:jobs
# Compose sets REDIS_URL=redis://redis:6379/0 and VERIFY_MODE=async on api (+ worker service).

# --- Object storage (optional S3-compatible: MinIO or AWS) ---
# auto (default): use S3 when S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY are set; else local disk
# local: always ./data/media + ./exports
# s3: require S3_* (fail closed on missing bucket/keys at put time)
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://127.0.0.1:9000          # omit for real AWS
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=dataplat
# S3_MEDIA_PREFIX=media/
# S3_EXPORTS_PREFIX=exports/
# S3_PRESIGN_TTL_SECONDS=3600
# Compose MinIO:
#   docker compose -f docker-compose.yml -f docker-compose.s3.yml --profile s3 up --build

# --- Auth mode ---
# auto (default): use Clerk when CLERK_SECRET_KEY + CLERK_ISSUER (or JWKS) set; else local dev JWT
# clerk: require Clerk (fail closed if keys missing) — use this on production API hosts
# dev: force local HS256 sessions via POST /api/auth/dev-login (UI /sign-in)
AUTH_MODE=auto

# --- Clerk (preferred IdP) ---
# Create an application at https://dashboard.clerk.com
# Dashboard → API Keys → Publishable key + Secret key
# Dashboard → Configure → API keys / JWT → Issuer looks like:
#   https://verb-noun-00.clerk.accounts.dev
# Do not invent or commit real keys — paste yours from the dashboard only.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
# Optional override (defaults to {CLERK_ISSUER}/.well-known/jwks.json)
# CLERK_JWKS_URL=

# Map roles in Clerk Dashboard → Users → Metadata → publicMetadata:
#   { "role": "admin" } | { "role": "buyer" } | { "role": "contributor" }
# Seed emails (admin@demo.local etc.) keep fixed roles when metadata is absent (dev only).

# --- Dev JWT (only when AUTH_MODE resolves to "dev") ---
# Never use the default secret on a public host.
DEV_JWT_SECRET=phase0-dev-jwt-secret-change-me
# DEV_JWT_TTL_SECONDS=43200

# --- Frontend local (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # same value as CLERK_PUBLISHABLE_KEY
# When NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is empty, UI uses /sign-in + Bearer tokens (not Act-as).

# =============================================================================
# Production — Netlify (Next.js frontend)
# Set in Netlify UI → Site configuration → Environment variables
# (or netlify.toml [build.environment] only for non-secrets)
# =============================================================================
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...   # or pk_test_ for staging
# NEXT_PUBLIC_API_URL=https://api.example.com    # public FastAPI base URL (no trailing slash)
# Optional if you later enable clerkMiddleware / server components that need the secret:
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...

# =============================================================================
# Production — FastAPI host (Railway / Fly / Render / VM / Docker)
# =============================================================================
# AUTH_MODE=clerk
# CLERK_SECRET_KEY=sk_live_...
# CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_ISSUER=https://verb-noun-00.clerk.accounts.dev
# # CLERK_JWKS_URL=https://verb-noun-00.clerk.accounts.dev/.well-known/jwks.json
# DATABASE_URL=postgresql+psycopg://...   # recommended once you leave demo SQLite
# # bind: uvicorn app.main:app --host 0.0.0.0 --port $PORT

# =============================================================================
# Clerk Dashboard — Allowed URLs (replace with your real hosts)
# Paths & URLs → Allowed redirect URLs / Allowed origins
# Sign-in uses /sign-in with hash routing (@clerk/nextjs SignIn routing="hash").
# =============================================================================
# Allowed origins:
#   http://localhost:3000
#   https://YOUR-SITE.netlify.app
#   https://YOUR-CUSTOM-DOMAIN
# Allowed redirect URLs:
#   http://localhost:3000
#   http://localhost:3000/sign-in
#   http://localhost:3000/*
#   https://YOUR-SITE.netlify.app
#   https://YOUR-SITE.netlify.app/sign-in
#   https://YOUR-SITE.netlify.app/*
#   https://YOUR-CUSTOM-DOMAIN/*
# After OAuth / sign-in, users land on /sign-in then the app routes by role
# (/admin | /buyer | /contributor) via GET /api/me.
