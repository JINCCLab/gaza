# data_platform Phase-0 — copy to backend/.env and/or frontend/.env.local

# --- Database (optional; default SQLite under ./data) ---
# DATABASE_URL=postgresql+psycopg://data:data@127.0.0.1:5432/data_platform

# --- Auth mode ---
# auto (default): use Clerk when CLERK_SECRET_KEY + CLERK_ISSUER (or JWKS) set; else local dev JWT
# clerk: require Clerk (fail closed if keys missing)
# dev: force local HS256 sessions via POST /api/auth/dev-login (UI /sign-in)
AUTH_MODE=auto

# --- Clerk (preferred IdP) ---
# Create an application at https://dashboard.clerk.com
# Frontend API → Publishable key; Backend → Secret key
# JWT → Issuer URL looks like https://verb-noun-00.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
# Optional override (defaults to {CLERK_ISSUER}/.well-known/jwks.json)
# CLERK_JWKS_URL=

# Map roles in Clerk Dashboard → Users → publicMetadata:
#   { "role": "admin" } | { "role": "buyer" } | { "role": "contributor" }
# Seed emails (admin@demo.local etc.) keep fixed roles when metadata is absent.

# --- Dev JWT (only when AUTH_MODE resolves to "dev") ---
DEV_JWT_SECRET=phase0-dev-jwt-secret-change-me
# DEV_JWT_TTL_SECONDS=43200

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # same as CLERK_PUBLISHABLE_KEY
# When NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is empty, UI uses /sign-in + Bearer tokens (not Act-as).
